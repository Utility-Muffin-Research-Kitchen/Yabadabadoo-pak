diff --git a/gfx/drivers_context/sdl_gl_ctx.c b/gfx/drivers_context/sdl_gl_ctx.c
index 20eff85..af504a2 100644
--- a/gfx/drivers_context/sdl_gl_ctx.c
+++ b/gfx/drivers_context/sdl_gl_ctx.c
@@ -74,6 +74,22 @@ typedef struct gfx_ctx_sdl_data
 
 /* TODO/FIXME - static global */
 static enum gfx_ctx_api sdl_api = GFX_CTX_OPENGL_API;
+static unsigned sdl_major, sdl_minor;
+
+/* video_context_driver_init_first() calls bind_api() before init(), and
+ * SDL ignores GL attributes set before its video subsystem is up (it resets
+ * them in SDL_VideoInit), so init() applies them again. */
+static void sdl_ctx_apply_gl_attributes(void)
+{
+#ifdef HAVE_SDL2
+   SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK,
+         sdl_api == GFX_CTX_OPENGL_ES_API
+         ? SDL_GL_CONTEXT_PROFILE_ES
+         : SDL_GL_CONTEXT_PROFILE_COMPATIBILITY);
+   SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, sdl_major);
+   SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, sdl_minor);
+#endif
+}
 
 static void sdl_ctx_destroy_resources(gfx_ctx_sdl_data_t *sdl)
 {
@@ -142,6 +158,8 @@ static void *sdl_ctx_init(void *video_driver)
       sdl->subsystem_inited = true;
    }
 
+   sdl_ctx_apply_gl_attributes();
+
    RARCH_LOG("[SDL GL] SDL %i.%i.%i gfx context driver initialized.\n",
          SDL_MAJOR_VERSION, SDL_MINOR_VERSION, SDL_PATCHLEVEL);
 
@@ -164,23 +182,14 @@ static bool sdl_ctx_bind_api(void *data,
       unsigned minor)
 {
 #ifdef HAVE_SDL2
-   unsigned profile;
-
    if (api != GFX_CTX_OPENGL_API && api != GFX_CTX_OPENGL_ES_API)
       return false;
-
-   profile = SDL_GL_CONTEXT_PROFILE_COMPATIBILITY;
-
-   if (api == GFX_CTX_OPENGL_ES_API)
-      profile = SDL_GL_CONTEXT_PROFILE_ES;
-
-   SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, profile);
-
-   SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, major);
-   SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, minor);
 #endif
 
-   sdl_api = api;
+   sdl_api   = api;
+   sdl_major = major;
+   sdl_minor = minor;
+   sdl_ctx_apply_gl_attributes();
 
 #ifndef HAVE_SDL2
    if (api != GFX_CTX_OPENGL_API)
