Honor swap intervals above 1 in the SDL context driver on Wayland.

SDL's Wayland backend clamps any swap interval above 1 to 1, on purpose
(Wayland_GLES_SetSwapInterval: "if (interval > 1) interval = 1;"): it paces each
swap on the previous commit's frame callback and cannot wait for a vsync count.
RetroArch never reads the applied value back. On the MLP1's 120 Hz mode, Auto
picks interval 2 for ~60 fps content and SDL silently makes it 1, so each game
frame waits one refresh instead of two and audio becomes the only throttle.
Measured with Genesis Plus GX: only 27% of presentations were the intended two
refreshes apart; the rest landed 1, 3, 4 or 5 apart.

Emulate the interval instead. When SDL reports it applied 1 for a request above
1 on the wayland backend, set EGL_SWAP_BEHAVIOR to EGL_BUFFER_PRESERVED on the
current draw surface and swap interval times per frame. Each repeat blocks on
the previous commit's frame callback, which is exactly the refresh of waiting the
clamp dropped, and presents the preserved copy of the same image. RetroArch's
own Auto logic stays the policy: 120 Hz with 59.92 fps selects 2, 50 fps stays 1
with forced nonblock, BFI and shader subframes force 1, and fast-forward drives
interval 0 through set_nonblock_state, which turns the repeats off.

Proven first as an LD_PRELOAD interposer: 99.8% of presentations one refresh
apart, screenshots of the repeats show the game image. The copy the driver makes
to preserve the buffer costs GPU time, so the attribute is only set while
repeating and put back to EGL_BUFFER_DESTROYED for intervals 0 and 1.

The early swap_interval call in gl2_init runs before the window exists and is
skipped; drivers_init applies the interval again through set_nonblock_state. A
surface replaced under us is re-preserved before the frame's first swap, so a
repeat never presents an undefined back buffer.

EGL is called directly rather than resolved at runtime: the MLP1 build already
configures --enable-egl and links libEGL.so.1, the library SDL loads.

diff --git a/gfx/drivers_context/sdl_gl_ctx.c b/gfx/drivers_context/sdl_gl_ctx.c
index 5766c44bf4..20eff8581f 100644
--- a/gfx/drivers_context/sdl_gl_ctx.c
+++ b/gfx/drivers_context/sdl_gl_ctx.c
@@ -37,6 +37,18 @@
 #include <SDL_webOS.h>
 #endif
 
+/* SDL's Wayland backend clamps swap intervals above 1 to 1: it paces each
+ * swap on the previous commit's frame callback and cannot wait for a vsync
+ * count. At 120 Hz that leaves ~60 fps content one refresh of wait per frame
+ * and audio as the only throttle, so frames land 1, 3 or 4 refreshes apart.
+ * Emulate the interval instead: preserve the back buffer and swap once per
+ * refresh the interval asks for. */
+#if defined(HAVE_SDL2) && defined(HAVE_EGL)
+#include <EGL/egl.h>
+#include <string/stdstring.h>
+#define SDL_CTX_EMULATE_SWAP_INTERVAL
+#endif
+
 typedef struct gfx_ctx_sdl_data
 {
 #ifdef HAVE_SDL2
@@ -44,6 +56,11 @@ typedef struct gfx_ctx_sdl_data
    SDL_GLContext  ctx;
 #else
    SDL_Surface *win;
+#endif
+#ifdef SDL_CTX_EMULATE_SWAP_INTERVAL
+   EGLSurface preserved_surface;
+   unsigned   extra_swaps;
+   int        swap_interval;
 #endif
    int  width;
    int  height;
@@ -172,10 +189,81 @@ static bool sdl_ctx_bind_api(void *data,
    return true;
 }
 
+#ifdef SDL_CTX_EMULATE_SWAP_INTERVAL
+/* Returns the current draw surface if the driver reports the new swap
+ * behavior back, EGL_NO_SURFACE otherwise. */
+static EGLSurface sdl_ctx_set_swap_behavior(EGLint behavior)
+{
+   EGLint     applied = 0;
+   EGLDisplay dpy     = eglGetCurrentDisplay();
+   EGLSurface surf    = eglGetCurrentSurface(EGL_DRAW);
+
+   if (     dpy  == EGL_NO_DISPLAY
+         || surf == EGL_NO_SURFACE
+         || !eglSurfaceAttrib(dpy, surf, EGL_SWAP_BEHAVIOR, behavior)
+         || !eglQuerySurface(dpy, surf, EGL_SWAP_BEHAVIOR, &applied)
+         || applied != behavior)
+      return EGL_NO_SURFACE;
+   return surf;
+}
+
+static void sdl_ctx_update_swap_emulation(gfx_ctx_sdl_data_t *sdl,
+      int interval)
+{
+   unsigned extra_swaps = 0;
+   bool preserve_failed = false;
+   int applied          = SDL_GL_GetSwapInterval();
+
+   if (     interval > 1
+         && applied == 1
+         && string_is_equal(SDL_GetCurrentVideoDriver(), "wayland"))
+   {
+      EGLSurface surf = sdl_ctx_set_swap_behavior(EGL_BUFFER_PRESERVED);
+      if (surf != EGL_NO_SURFACE)
+      {
+         sdl->preserved_surface = surf;
+         extra_swaps            = interval - 1;
+      }
+      else
+         preserve_failed        = true;
+   }
+
+   if (!extra_swaps && sdl->preserved_surface != EGL_NO_SURFACE)
+   {
+      /* Intervals 0 and 1 must not pay for the copy. A surface that has
+       * been replaced since needs no restoring. */
+      if (eglGetCurrentSurface(EGL_DRAW) == sdl->preserved_surface)
+         sdl_ctx_set_swap_behavior(EGL_BUFFER_DESTROYED);
+      sdl->preserved_surface = EGL_NO_SURFACE;
+   }
+
+   if (     (interval > 1 || extra_swaps || sdl->extra_swaps)
+         && (interval != sdl->swap_interval || extra_swaps != sdl->extra_swaps))
+      RARCH_LOG("[SDL GL] Swap interval %d requested, %d applied: "
+            "%u extra swap(s) per frame%s.\n",
+            interval, applied, extra_swaps,
+            extra_swaps     ? " on a preserved back buffer"
+            : preserve_failed ? ", back buffer could not be preserved"
+            : "");
+
+   sdl->swap_interval = interval;
+   sdl->extra_swaps   = extra_swaps;
+}
+#endif
+
 static void sdl_ctx_swap_interval(void *data, int interval)
 {
 #ifdef HAVE_SDL2
    SDL_GL_SetSwapInterval(interval);
+#ifdef SDL_CTX_EMULATE_SWAP_INTERVAL
+   {
+      gfx_ctx_sdl_data_t *sdl = (gfx_ctx_sdl_data_t*)data;
+      /* gl2_init asks before the window exists; the interval is
+       * applied again through set_nonblock_state once it does. */
+      if (sdl && sdl->ctx)
+         sdl_ctx_update_swap_emulation(sdl, interval);
+   }
+#endif
 #else
    SDL_GL_SetAttribute(SDL_GL_SWAP_CONTROL, interval);
 #endif
@@ -390,7 +478,23 @@ static void sdl_ctx_swap_buffers(void *data)
 #ifdef HAVE_SDL2
    gfx_ctx_sdl_data_t *sdl = (gfx_ctx_sdl_data_t*)data;
    if (sdl)
+   {
+#ifdef SDL_CTX_EMULATE_SWAP_INTERVAL
+      unsigned i;
+      /* A replaced surface starts out unpreserved. Re-establish it before
+       * this frame's first swap so the repeats below stay defined. */
+      if (      sdl->extra_swaps
+            && eglGetCurrentSurface(EGL_DRAW) != sdl->preserved_surface)
+         sdl_ctx_update_swap_emulation(sdl, sdl->swap_interval);
+#endif
       SDL_GL_SwapWindow(sdl->win);
+#ifdef SDL_CTX_EMULATE_SWAP_INTERVAL
+      /* Each repeat waits on the previous commit's frame callback: one
+       * refresh per repeat, the wait SDL's clamp dropped. */
+      for (i = 0; i < sdl->extra_swaps; i++)
+         SDL_GL_SwapWindow(sdl->win);
+#endif
+   }
 #else
    SDL_GL_SwapBuffers();
 #endif
