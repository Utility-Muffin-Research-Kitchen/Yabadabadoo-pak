+bool command_open_menu(command_t *cmd, const char *arg)
+{
+   (void)cmd;
+
+#ifdef HAVE_MENU
+   {
+      struct menu_state *menu_st = menu_state_get_ptr();
+      if (!(menu_st->flags & MENU_ST_FLAG_ALIVE))
+         retroarch_menu_running();
+
+      if (string_is_equal(arg, "SHADERS"))
+      {
+         const char *label             = msg_hash_to_str(MENU_ENUM_LABEL_SHADER_OPTIONS);
+         const char *stack_label       = NULL;
+         menu_list_t *menu_list        = menu_st->entries.list;
+         file_list_t *menu_stack       = MENU_LIST_GET(menu_list, 0);
+         file_list_t *selection        = MENU_LIST_GET_SELECTION(menu_list, 0);
+         menu_displaylist_info_t info;
+         bool pushed;
+
+         if (!menu_stack || !selection)
+            return false;
+
+         menu_entries_flush_stack(label, 0);
+         menu_entries_get_last_stack(NULL, &stack_label, NULL, NULL, NULL);
+
+         menu_displaylist_info_init(&info);
+         info.list     = selection;
+         info.path     = strdup(label);
+         info.label    = strdup(label);
+         info.enum_idx = MENU_ENUM_LABEL_SHADER_OPTIONS;
+         info.type     = MENU_SETTING_ACTION;
+         if (!info.path || !info.label ||
+             (!string_is_equal(stack_label, label) &&
+              !menu_entries_append(menu_stack, label, label,
+                  MENU_ENUM_LABEL_SHADER_OPTIONS, MENU_SETTING_ACTION,
+                  0, 0, NULL)))
+         {
+            menu_displaylist_info_free(&info);
+            return false;
+         }
+
+         menu_st->selection_ptr = 0;
+         pushed = menu_displaylist_ctl(DISPLAYLIST_OPTIONS_SHADERS, &info,
+                     config_get_ptr()) && menu_displaylist_process(&info);
+         menu_displaylist_info_free(&info);
+         if (pushed && menu_st->driver_ctx && menu_st->driver_ctx->navigation_set)
+            menu_st->driver_ctx->navigation_set(menu_st->userdata, true);
+         return pushed;
+      }
+   }
+   return true;
+#else
+   (void)arg;
+   return false;
+#endif
+}
