+bool command_save_state_slot(command_t *cmd, const char *arg)
+{
+   char state_path[PATH_MAX_LENGTH] = "";
+   char reply[128]                  = "";
+   char *end                        = NULL;
+   long slot                        = 0;
+   bool savestates_enabled          = core_info_current_supports_savestate();
+   bool ret                         = false;
+
+   if (!arg || !arg[0])
+   {
+      strlcpy(reply, "SAVE_STATE_SLOT", sizeof(reply));
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   slot = strtol(arg, &end, 10);
+   snprintf(reply, sizeof(reply), "SAVE_STATE_SLOT %ld", slot);
+   if (!savestates_enabled || arg == end ||
+       (end && *end != '\0') || slot < -1)
+   {
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   if (!runloop_get_savestate_path(state_path, sizeof(state_path), (int)slot) ||
+       core_serialize_size() == 0)
+   {
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   if (slot == -1)
+      ret = content_auto_save_state(state_path);
+   else
+      ret = content_save_state(state_path, true);
+
+   cmd->replier(cmd, reply, strlen(reply));
+   return ret;
+}
+
+/* UMRK power-hold save capability. Reply:
+ *   GET_STATE_SAVE_INFO 1 <serialized bytes> <compressed 0|1>
+ *   GET_STATE_SAVE_INFO 1 NO
+ * The leading 1 is the SAVE_STATE_SYNC protocol version. Clients that
+ * get no reply or an unknown version must not request a synchronous save. */
+bool command_get_state_save_info(command_t *cmd, const char *arg)
+{
+   char reply[128]  = "";
+   size_t _len      = 0;
+   bool compressed  = false;
+   (void)arg;
+
+#if defined(HAVE_ZLIB)
+   {
+      settings_t *settings = config_get_ptr();
+      compressed = settings && settings->bools.savestate_file_compression;
+   }
+#endif
+
+   if (   !core_info_current_supports_savestate()
+       || core_serialize_size() == 0)
+      _len = strlcpy(reply, "GET_STATE_SAVE_INFO 1 NO", sizeof(reply));
+   else
+      _len = snprintf(reply, sizeof(reply), "GET_STATE_SAVE_INFO 1 %llu %d",
+            (unsigned long long)content_get_serialized_size(),
+            compressed ? 1 : 0);
+
+   cmd->replier(cmd, reply, _len);
+   return true;
+}
+
+static bool command_sync_request_id_valid(const char *id)
+{
+   size_t i;
+   if (!id || !*id)
+      return false;
+   for (i = 0; id[i]; i++)
+   {
+      char c = id[i];
+      if (i >= 32)
+         return false;
+      if (!(   (c >= '0' && c <= '9')
+            || (c >= 'a' && c <= 'z')
+            || (c >= 'A' && c <= 'Z')
+            || c == '-' || c == '_'))
+         return false;
+   }
+   return true;
+}
+
+/* UMRK power-hold save: SAVE_STATE_SYNC <id> <slot> <max bytes> <start by ms>
+ * Writes the slot's state to "<slot path>.tmp-<id>" synchronously, fsyncs it,
+ * and replies exactly once:
+ *   SAVE_STATE_SYNC <id> TMP_READY <bytes> <temporary path>
+ *   SAVE_STATE_SYNC <id> ERROR <code>
+ * The client owns publication: RetroArch never renames the temporary file, so
+ * a reply the client gave up on can never replace the existing slot. */
+bool command_save_state_sync(command_t *cmd, const char *arg)
+{
+   char id[33]                      = "";
+   char state_path[PATH_MAX_LENGTH] = "";
+   char tmp_path[PATH_MAX_LENGTH]   = "";
+   char reply[PATH_MAX_LENGTH + 96] = "";
+   long slot                        = 0;
+   unsigned long long max_bytes     = 0;
+   long long start_by_ms            = 0;
+   char trailing                    = 0;
+   size_t written                   = 0;
+   const char *error                = NULL;
+   enum content_sync_save_result result;
+
+   if (  !arg
+       || sscanf(arg, "%32s %ld %llu %lld %c", id, &slot, &max_bytes,
+             &start_by_ms, &trailing) != 4
+       || !command_sync_request_id_valid(id))
+   {
+      /* No trustworthy id to echo. */
+      strlcpy(reply, "SAVE_STATE_SYNC - ERROR BAD_ARGS", sizeof(reply));
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   if (slot < 0 || slot > 999 || max_bytes == 0 || start_by_ms <= 0)
+      error = "BAD_ARGS";
+   else if (!runloop_get_savestate_path(state_path, sizeof(state_path), (int)slot))
+      error = "PATH";
+   else if ((size_t)snprintf(tmp_path, sizeof(tmp_path), "%s.tmp-%s",
+            state_path, id) >= sizeof(tmp_path))
+      error = "PATH";
+
+   if (!error)
+   {
+      result = content_save_state_sync_file(tmp_path, (uint64_t)max_bytes,
+            (int64_t)start_by_ms, &written);
+      if (result != CONTENT_SYNC_SAVE_OK)
+         error = content_sync_save_result_str(result);
+   }
+
+   if (error)
+   {
+      RARCH_WARN("[State] SAVE_STATE_SYNC %s failed: %s\n", id, error);
+      snprintf(reply, sizeof(reply), "SAVE_STATE_SYNC %s ERROR %s", id, error);
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   RARCH_LOG("[State] SAVE_STATE_SYNC %s ready: %llu bytes\n",
+         id, (unsigned long long)written);
+   snprintf(reply, sizeof(reply), "SAVE_STATE_SYNC %s TMP_READY %llu %s",
+         id, (unsigned long long)written, tmp_path);
+   cmd->replier(cmd, reply, strlen(reply));
+   return true;
+}
+
+/* UMRK boot resume: LOAD_STATE_SYNC <id> <slot>
+ * Reads the slot's state and applies it to the running core synchronously,
+ * then replies exactly once:
+ *   LOAD_STATE_SYNC <id> OK <bytes>
+ *   LOAD_STATE_SYNC <id> ERROR <code>
+ *   LOAD_STATE_SYNC - ERROR BAD_ARGS      (unparseable line or id)
+ * Unlike LOAD_STATE_SLOT there is no task, no undo buffer and no retry: the
+ * reply is the answer to whether this exact file is now the running state. */
+bool command_load_state_sync(command_t *cmd, const char *arg)
+{
+   char id[33]                      = "";
+   char state_path[PATH_MAX_LENGTH] = "";
+   char reply[128]                  = "";
+   long slot                        = 0;
+   char trailing                    = 0;
+   size_t loaded                    = 0;
+   const char *error                = NULL;
+   enum content_sync_load_result result;
+
+   /* %32s stops at 32 characters and would let the rest of a longer id
+    * parse as the slot, so measure the token first. */
+   if (  !arg
+       || strcspn(arg, " ") > 32
+       || sscanf(arg, "%32s %ld %c", id, &slot, &trailing) != 2
+       || !command_sync_request_id_valid(id))
+   {
+      strlcpy(reply, "LOAD_STATE_SYNC - ERROR BAD_ARGS", sizeof(reply));
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   if (slot < 0 || slot > 999)
+      error = "BAD_ARGS";
+   else if (!runloop_get_savestate_path(state_path, sizeof(state_path), (int)slot))
+      error = "PATH";
+
+   if (!error)
+   {
+      result = content_load_state_sync_file(state_path, &loaded);
+      if (result != CONTENT_SYNC_LOAD_OK)
+         error = content_sync_load_result_str(result);
+   }
+
+   if (error)
+   {
+      RARCH_WARN("[State] LOAD_STATE_SYNC %s failed: %s\n", id, error);
+      snprintf(reply, sizeof(reply), "LOAD_STATE_SYNC %s ERROR %s", id, error);
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   command_post_state_loaded();
+   RARCH_LOG("[State] LOAD_STATE_SYNC %s loaded: %llu bytes\n",
+         id, (unsigned long long)loaded);
+   snprintf(reply, sizeof(reply), "LOAD_STATE_SYNC %s OK %llu",
+         id, (unsigned long long)loaded);
+   cmd->replier(cmd, reply, strlen(reply));
+   return true;
+}
 
