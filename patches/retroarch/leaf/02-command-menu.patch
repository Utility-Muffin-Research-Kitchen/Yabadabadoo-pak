+bool command_get_perf_info(command_t *cmd, const char *arg)
+{
+   char reply[512]                = "";
+   double refresh_rate            = 0.0;
+   double deviation               = 0.0;
+   double frame_time_p95_ms       = 0.0;
+   unsigned samples               = 0;
+   unsigned i                     = 0;
+   bool video_ready               = false;
+   bool audio_ready               = false;
+   video_driver_state_t *video_st = video_state_get_ptr();
+   audio_statistics_t audio_stats;
+   retro_time_t sorted[MEASURE_FRAME_TIME_SAMPLES_COUNT];
+   (void)arg;
+
+   audio_stats.samples                    = 0;
+   audio_stats.average_buffer_saturation  = 0.0f;
+   audio_stats.std_deviation_percentage   = 0.0f;
+   audio_stats.close_to_underrun          = 0.0f;
+   audio_stats.close_to_blocking          = 0.0f;
+
+   if (video_st)
+      video_ready = video_monitor_fps_statistics(
+            &refresh_rate, &deviation, &samples);
+
+   if (video_ready)
+   {
+      for (i = 0; i < samples; i++)
+         sorted[i] = video_st->frame_time_samples[i];
+      qsort(sorted, samples, sizeof(sorted[0]), command_compare_frame_times);
+      frame_time_p95_ms =
+         (double)sorted[((samples - 1) * 95) / 100] / 1000.0;
+   }
+
+   audio_ready = audio_compute_buffer_statistics(&audio_stats);
+
+   snprintf(reply, sizeof(reply),
+         "GET_PERF_INFO ready=%u fps=%.3f frame_time_p95_ms=%.3f "
+         "deviation_pct=%.3f samples=%u frames=%llu dropped=%u "
+         "audio_ready=%u audio_samples=%u audio_underrun_pct=%.3f "
+         "audio_blocking_pct=%.3f",
+         video_ready ? 1 : 0,
+         refresh_rate,
+         frame_time_p95_ms,
+         deviation * 100.0,
+         samples,
+         video_st ? (unsigned long long)video_st->frame_count : 0,
+         video_st ? video_st->frame_drop_count : 0,
+         audio_ready ? 1 : 0,
+         audio_stats.samples,
+         audio_stats.close_to_underrun,
+         audio_stats.close_to_blocking);
+
+   cmd->replier(cmd, reply, strlen(reply));
+   return true;
+}
