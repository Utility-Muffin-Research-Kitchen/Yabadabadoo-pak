+static int64_t content_sync_save_now_ms(void)
+{
+   struct timespec ts;
+   if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+      return -1;
+   return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+const char *content_sync_save_result_str(enum content_sync_save_result result)
+{
+   switch (result)
+   {
+      case CONTENT_SYNC_SAVE_OK:          return "OK";
+      case CONTENT_SYNC_SAVE_UNSUPPORTED: return "UNSUPPORTED";
+      case CONTENT_SYNC_SAVE_COMPRESSED:  return "COMPRESSED";
+      case CONTENT_SYNC_SAVE_BUSY:        return "BUSY";
+      case CONTENT_SYNC_SAVE_SERIALIZE:   return "SERIALIZE";
+      case CONTENT_SYNC_SAVE_TOO_LARGE:   return "TOO_LARGE";
+      case CONTENT_SYNC_SAVE_LATE:        return "LATE";
+      case CONTENT_SYNC_SAVE_OPEN:        return "OPEN";
+      case CONTENT_SYNC_SAVE_WRITE:       return "WRITE";
+      case CONTENT_SYNC_SAVE_FSYNC:       return "FSYNC";
+      case CONTENT_SYNC_SAVE_CLOSE:       return "CLOSE";
+   }
+   return "UNKNOWN";
+}
+
+enum content_sync_save_result content_save_state_sync_file(const char *path,
+      uint64_t max_bytes, int64_t start_by_ms, size_t *out_len)
+{
+   size_t _len;
+   size_t done;
+   int fd;
+   int64_t now_ms;
+   void *serial_data  = NULL;
+   settings_t *settings = config_get_ptr();
+
+   if (out_len)
+      *out_len = 0;
+   if (!path || !*path || max_bytes == 0)
+      return CONTENT_SYNC_SAVE_UNSUPPORTED;
+   if (!core_info_current_supports_savestate() || core_serialize_size() == 0)
+      return CONTENT_SYNC_SAVE_UNSUPPORTED;
+#if defined(HAVE_ZLIB)
+   /* The power-hold budget was measured on uncompressed writes. */
+   if (settings && settings->bools.savestate_file_compression)
+      return CONTENT_SYNC_SAVE_COMPRESSED;
+#else
+   (void)settings;
+#endif
+   if (content_save_state_in_progress(NULL) || content_load_state_in_progress(NULL))
+      return CONTENT_SYNC_SAVE_BUSY;
+   if (content_get_serialized_size() > max_bytes)
+      return CONTENT_SYNC_SAVE_TOO_LARGE;
+   if ((now_ms = content_sync_save_now_ms()) < 0 || now_ms > start_by_ms)
+      return CONTENT_SYNC_SAVE_LATE;
+
+   if (!(serial_data = content_get_serialized_data(&_len)))
+      return CONTENT_SYNC_SAVE_SERIALIZE;
+
+   /* Recheck both bounds after serialization and before touching the disk:
+    * a late write must not begin after the admitted window. */
+   if ((uint64_t)_len > max_bytes)
+   {
+      free(serial_data);
+      return CONTENT_SYNC_SAVE_TOO_LARGE;
+   }
+   if ((now_ms = content_sync_save_now_ms()) < 0 || now_ms > start_by_ms)
+   {
+      free(serial_data);
+      return CONTENT_SYNC_SAVE_LATE;
+   }
+
+   fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0644);
+   if (fd < 0)
+   {
+      RARCH_ERR("[State] Sync save could not create \"%s\": %s\n",
+            path, strerror(errno));
+      free(serial_data);
+      return CONTENT_SYNC_SAVE_OPEN;
+   }
+
+   for (done = 0; done < _len; )
+   {
+      ssize_t n = write(fd, (const char*)serial_data + done, _len - done);
+      if (n < 0 && errno == EINTR)
+         continue;
+      if (n <= 0)
+      {
+         RARCH_ERR("[State] Sync save write failed for \"%s\": %s\n",
+               path, n < 0 ? strerror(errno) : "short write");
+         close(fd);
+         unlink(path);
+         free(serial_data);
+         return CONTENT_SYNC_SAVE_WRITE;
+      }
+      done += (size_t)n;
+   }
+   free(serial_data);
+
+   if (fsync(fd) != 0)
+   {
+      RARCH_ERR("[State] Sync save fsync failed for \"%s\": %s\n",
+            path, strerror(errno));
+      close(fd);
+      unlink(path);
+      return CONTENT_SYNC_SAVE_FSYNC;
+   }
+   if (close(fd) != 0)
+   {
+      RARCH_ERR("[State] Sync save close failed for \"%s\": %s\n",
+            path, strerror(errno));
+      unlink(path);
+      return CONTENT_SYNC_SAVE_CLOSE;
+   }
+
+   if (out_len)
+      *out_len = _len;
+   return CONTENT_SYNC_SAVE_OK;
+}
+
+/* Room for the optional achievement and replay blocks of a RASTATE file
+ * beyond what the running core serializes. */
+#define CONTENT_SYNC_LOAD_HEADROOM (16u * 1024u * 1024u)
+
+const char *content_sync_load_result_str(enum content_sync_load_result result)
+{
+   switch (result)
+   {
+      case CONTENT_SYNC_LOAD_OK:          return "OK";
+      case CONTENT_SYNC_LOAD_UNSUPPORTED: return "UNSUPPORTED";
+      case CONTENT_SYNC_LOAD_HARDCORE:    return "HARDCORE";
+      case CONTENT_SYNC_LOAD_BUSY:        return "BUSY";
+      case CONTENT_SYNC_LOAD_OPEN:        return "OPEN";
+      case CONTENT_SYNC_LOAD_READ:        return "READ";
+      case CONTENT_SYNC_LOAD_TOO_LARGE:   return "TOO_LARGE";
+      case CONTENT_SYNC_LOAD_UNSERIALIZE: return "UNSERIALIZE";
+   }
+   return "UNKNOWN";
+}
+
+/* Walks a RASTATE1 buffer the way content_load_rastate1() does, but checks
+ * every block against the buffer first: that parser trusts the block sizes,
+ * so a truncated file would hand the core a size that runs past the read.
+ * Requires a MEM block and the END block the writer always appends, which
+ * is what turns any truncation into a refusal. */
+static bool content_sync_load_rastate_bounded(const unsigned char *data,
+      size_t len)
+{
+   size_t pos    = 8;
+   bool seen_mem = false;
+
+   if (len < 8 || data[7] != RASTATE_VERSION)
+      return false;
+
+   while (len - pos >= 8)
+   {
+      const unsigned char *marker = data + pos;
+      size_t block_size           = (size_t)marker[4]
+         | ((size_t)marker[5] << 8)
+         | ((size_t)marker[6] << 16)
+         | ((size_t)marker[7] << 24);
+
+      pos += 8;
+      if (memcmp(marker, RASTATE_END_BLOCK, 4) == 0)
+         return seen_mem;
+      if (block_size > len - pos || CONTENT_ALIGN_SIZE(block_size) > len - pos)
+         return false;
+      if (memcmp(marker, RASTATE_MEM_BLOCK, 4) == 0)
+      {
+         if (block_size == 0)
+            return false;
+         seen_mem = true;
+      }
+      pos += CONTENT_ALIGN_SIZE(block_size);
+   }
+   return false;
+}
+
+enum content_sync_load_result content_load_state_sync_file(const char *path,
+      size_t *out_len)
+{
+   struct stat st;
+   size_t serialized_size;
+   size_t _len;
+   size_t done;
+   int fd;
+   unsigned char *data = NULL;
+
+   if (out_len)
+      *out_len = 0;
+   if (!path || !*path)
+      return CONTENT_SYNC_LOAD_UNSUPPORTED;
+   if (   !core_info_current_supports_savestate()
+       || (serialized_size = content_get_serialized_size()) == 0)
+      return CONTENT_SYNC_LOAD_UNSUPPORTED;
+#ifdef HAVE_CHEEVOS
+   if (rcheevos_hardcore_active())
+      return CONTENT_SYNC_LOAD_HARDCORE;
+#endif
+   if (content_save_state_in_progress(NULL) || content_load_state_in_progress(NULL))
+      return CONTENT_SYNC_LOAD_BUSY;
+
+   fd = open(path, O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+   {
+      RARCH_ERR("[State] Sync load could not open \"%s\": %s\n",
+            path, strerror(errno));
+      return CONTENT_SYNC_LOAD_OPEN;
+   }
+   if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode))
+   {
+      RARCH_ERR("[State] Sync load \"%s\" is not a regular file.\n", path);
+      close(fd);
+      return CONTENT_SYNC_LOAD_OPEN;
+   }
+   /* The file can only exceed what this core writes by the optional
+    * achievement and replay blocks. Anything past that headroom is not a
+    * state for this session and is refused before allocating for it. */
+   if (   st.st_size < 0
+       || (uint64_t)st.st_size > (uint64_t)serialized_size
+            + CONTENT_SYNC_LOAD_HEADROOM)
+   {
+      close(fd);
+      return CONTENT_SYNC_LOAD_TOO_LARGE;
+   }
+   _len = (size_t)st.st_size;
+   if (_len < 8)
+   {
+      close(fd);
+      return CONTENT_SYNC_LOAD_UNSERIALIZE;
+   }
+   if (!(data = (unsigned char*)malloc(_len)))
+   {
+      close(fd);
+      return CONTENT_SYNC_LOAD_READ;
+   }
+
+   for (done = 0; done < _len; )
+   {
+      ssize_t n = read(fd, data + done, _len - done);
+      if (n < 0 && errno == EINTR)
+         continue;
+      if (n <= 0)
+      {
+         RARCH_ERR("[State] Sync load read failed for \"%s\": %s\n",
+               path, n < 0 ? strerror(errno) : "short read");
+         close(fd);
+         free(data);
+         return CONTENT_SYNC_LOAD_READ;
+      }
+      done += (size_t)n;
+   }
+   close(fd);
+
+   /* Uncompressed only, like the save: a compressed state is not a state
+    * this path can apply. Raw core data without a RASTATE header goes
+    * straight to the core, which checks the size itself. */
+   if (   memcmp(data, "#RZIPv", 6) == 0
+       || (   memcmp(data, "RASTATE", 7) == 0
+           && !content_sync_load_rastate_bounded(data, _len))
+       || !content_deserialize_state(data, _len))
+   {
+      RARCH_ERR("[State] Sync load could not apply \"%s\".\n", path);
+      free(data);
+      return CONTENT_SYNC_LOAD_UNSERIALIZE;
+   }
+   free(data);
+
+   if (out_len)
+      *out_len = _len;
+   return CONTENT_SYNC_LOAD_OK;
+}
