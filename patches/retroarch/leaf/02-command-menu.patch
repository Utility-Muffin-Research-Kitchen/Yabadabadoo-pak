+enum content_sync_save_result
+{
+   CONTENT_SYNC_SAVE_OK = 0,
+   CONTENT_SYNC_SAVE_UNSUPPORTED,
+   CONTENT_SYNC_SAVE_COMPRESSED,
+   CONTENT_SYNC_SAVE_BUSY,
+   CONTENT_SYNC_SAVE_SERIALIZE,
+   CONTENT_SYNC_SAVE_TOO_LARGE,
+   CONTENT_SYNC_SAVE_LATE,
+   CONTENT_SYNC_SAVE_OPEN,
+   CONTENT_SYNC_SAVE_WRITE,
+   CONTENT_SYNC_SAVE_FSYNC,
+   CONTENT_SYNC_SAVE_CLOSE
+};
+
+/* UMRK: serialize and write an uncompressed state to a new file at @path,
+ * blocking, with no thumbnail. The file is created exclusively, fully
+ * written, fsync'd and closed before OK is returned; on any failure the
+ * partial file is removed. Fails LATE without opening @path when
+ * CLOCK_MONOTONIC is past @start_by_ms, and TOO_LARGE when the serialized
+ * state exceeds @max_bytes. */
+enum content_sync_save_result content_save_state_sync_file(const char *path,
+      uint64_t max_bytes, int64_t start_by_ms, size_t *out_len);
+
+const char *content_sync_save_result_str(enum content_sync_save_result result);
+
+/* Result of content_load_state_sync_file(). */
+enum content_sync_load_result
+{
+   CONTENT_SYNC_LOAD_OK = 0,
+   CONTENT_SYNC_LOAD_UNSUPPORTED,
+   CONTENT_SYNC_LOAD_HARDCORE,
+   CONTENT_SYNC_LOAD_BUSY,
+   CONTENT_SYNC_LOAD_OPEN,
+   CONTENT_SYNC_LOAD_READ,
+   CONTENT_SYNC_LOAD_TOO_LARGE,
+   CONTENT_SYNC_LOAD_UNSERIALIZE
+};
+
+/* UMRK: read the uncompressed state at @path and apply it to the running
+ * core, blocking. No undo buffer, no SRAM preservation, no task. Fails
+ * UNSERIALIZE for a compressed or truncated file and for any state the core
+ * rejects; on failure the core may hold a partially applied state, and the
+ * caller is expected to quit rather than play on. */
+enum content_sync_load_result content_load_state_sync_file(const char *path,
+      size_t *out_len);
