+bool command_get_info(command_t *cmd, const char *arg)
+{
+   size_t _len                    = 0;
+   char reply[128]                = "";
+   runloop_state_t *runloop_st    = runloop_state_get_ptr();
+   rarch_system_info_t *sys_info  = runloop_st
+      ? (rarch_system_info_t*)&runloop_st->system
+      : NULL;
+   unsigned disk_count            = 0;
+   unsigned disk_slot             = 0;
+   bool savestates_enabled        = core_info_current_supports_savestate();
+   (void)arg;
+
+   if (sys_info)
+   {
+      disk_count = disk_control_get_num_images(&sys_info->disk_control);
+      disk_slot  = disk_control_get_image_index(&sys_info->disk_control);
+   }
+
+   _len  = snprintf(reply, sizeof(reply), "GET_INFO %u %u ", disk_count, disk_slot);
+   if (savestates_enabled)
+      _len += snprintf(reply + _len, sizeof(reply) - _len, "%d",
+            (int)runloop_get_current_savestate());
+   else
+      _len += strlcpy(reply + _len, "NO", sizeof(reply) - _len);
+
+   cmd->replier(cmd, reply, _len);
